<%- include('layout', { title, body: `
<div class="page-header">
    <h1>Create New Job</h1>
    <a href="/" class="btn-secondary">Cancel</a>
</div>

${error ? `<div class="error-message">${error}</div>` : ''}

<form method="POST" action="/jobs" class="form">
    <div class="form-group">
        <label for="jobId">Job ID</label>
        <input type="text" id="jobId" name="jobId" required pattern="[A-Z]+-[0-9]{3}"
               placeholder="PROJECT-001" title="Format: PROJECT-NNN (uppercase letters, hyphen, 3 digits)">
        <small>Format: PROJECT-NNN (e.g., DESK-001, REVIEW-042)</small>
    </div>

    <div class="form-group">
        <label for="title">Job Title</label>
        <input type="text" id="title" name="title" required placeholder="Brief description of the job">
    </div>

    <button type="submit" class="btn-primary">Create Job</button>
</form>

<div class="help-text">
    <h3>Job Creation</h3>
    <p>Jobs are created with the following structure:</p>
    <ul>
        <li><strong>inputs/</strong> - Place input files here</li>
        <li><strong>output/</strong> - Generated artifacts go here</li>
        <li><strong>tmp/</strong> - Temporary files and logs</li>
        <li><strong>meta.json</strong> - Job metadata</li>
        <li><strong>plan.md</strong> - Execution plan</li>
        <li><strong>progress.md</strong> - Progress log</li>
        <li><strong>session-handoff.md</strong> - Session continuity notes</li>
    </ul>
</div>
` }) %>
