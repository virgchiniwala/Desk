<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Desk</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/chat.css">
  <style>
    .model-selector {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-left: 20px;
      font-size: 14px;
    }

    .model-selector label {
      color: #666;
      font-weight: 500;
    }

    .model-selector select {
      padding: 6px 12px;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-size: 14px;
      background: white;
      cursor: pointer;
      transition: all 0.2s;
    }

    .model-selector select:hover {
      border-color: #6366f1;
    }

    .model-selector select:focus {
      outline: none;
      border-color: #6366f1;
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }

    .settings-link {
      display: inline-block;
      margin-right: 15px;
      font-size: 20px;
      text-decoration: none;
      opacity: 0.6;
      transition: opacity 0.2s;
    }

    .settings-link:hover {
      opacity: 1;
    }
  </style>
</head>
<body class="chat-layout">
  <!-- Header -->
  <div class="chat-header">
    <div class="header-left">
      <span class="logo">Desk AI</span>
      <% if (overridesAllowed && userConfig) { %>
        <div class="model-selector">
          <label for="modelSelect">Model:</label>
          <select id="modelSelect">
            <option value="default" <%= !conversation.model_ref || conversation.model_ref === 'default' ? 'selected' : '' %>>
              Default (<%= defaultInfo.provider %>/<%= defaultInfo.model.substring(0, 20) %>)
            </option>
            <option value="user" <%= conversation.model_ref === 'user' ? 'selected' : '' %>>
              <%= userConfig.provider %>/<%= userConfig.model.substring(0, 20) %>
            </option>
          </select>
        </div>
      <% } %>
    </div>
    <div class="header-right">
      <a href="/settings/models" class="settings-link" title="Model Settings">⚙️</a>
      <span class="user-name">@<%= session.user.username %></span>
      <form method="POST" action="/logout" style="display: inline;">
        <button type="submit" class="btn-logout">Logout</button>
      </form>
    </div>
  </div>

  <!-- Three-panel layout -->
  <div class="chat-container">
    <!-- LEFT: Sidebar (20%) -->
    <div class="sidebar">
      <div class="sidebar-header">
        <form method="POST" action="/chat">
          <button type="submit" class="btn-new-chat">+ New Conversation</button>
        </form>
      </div>

      <div class="conversations-list">
        <% if (conversations.length === 0) { %>
          <div class="empty-state">No conversations yet</div>
        <% } else { %>
          <% conversations.forEach(convo => { %>
            <a
              href="/chat/<%= convo.id %>"
              class="conversation-item <%= convo.id == conversation.id ? 'active' : '' %>"
            >
              <div class="conversation-title">
                <%= convo.title || 'New Conversation' %>
              </div>
              <div class="conversation-date">
                <%= new Date(convo.updated_at).toLocaleDateString() %>
              </div>
            </a>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- CENTER: Chat (50%) -->
    <div class="chat-main">
      <div class="messages" id="messages">
        <% if (messages.length === 0) { %>
          <div class="empty-chat">
            <div class="empty-chat-icon">💬</div>
            <h2>Start a Conversation</h2>
            <p>Describe your goal and I'll help you accomplish it using Desk.</p>
          </div>
        <% } else { %>
          <% messages.forEach(msg => { %>
            <div class="message <%= msg.role %>">
              <div class="message-icon">
                <%= msg.role === 'user' ? '👤' : '🤖' %>
              </div>
              <div class="message-content">
                <div class="message-text"><%= msg.content %></div>
                <div class="message-time">
                  <%= new Date(msg.created_at).toLocaleTimeString() %>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

      <div class="chat-input-container">
        <form id="chatForm">
          <div class="input-row">
            <textarea
              id="messageInput"
              name="message"
              placeholder="Type your message..."
              rows="3"
              required
            ></textarea>
            <div class="input-actions">
              <label for="fileInput" class="btn-icon" title="Upload files">
                📎
              </label>
              <input
                type="file"
                id="fileInput"
                multiple
                accept="*/*"
                style="display: none;"
              >
              <button type="submit" class="btn-send" title="Send message">
                Send
              </button>
            </div>
          </div>
          <div id="uploadedFiles" class="uploaded-files"></div>
        </form>
      </div>
    </div>

    <!-- RIGHT: Task Panel (30%) -->
    <div class="task-panel">
      <div class="task-panel-header">
        <h3>📋 Tasks</h3>
      </div>

      <div class="task-panel-content" id="taskPanel">
        <div class="deck-workflow-card">
          <div class="deck-workflow-header">Deck Workflow</div>
          <div id="deckReadinessStatus" class="deck-status deck-status-idle">
            Upload one CSV and one PPTX to begin.
          </div>
          <div id="deckInputFiles" class="deck-input-files"></div>
          <div class="deck-actions">
            <button type="button" id="deckPlanBtn" class="btn-deck btn-deck-secondary" disabled>
              Generate Plan
            </button>
            <button type="button" id="deckRunBtn" class="btn-deck btn-deck-primary" disabled>
              Approve &amp; Run
            </button>
          </div>
          <div id="deckPlanDetails" class="deck-plan-details"></div>
        </div>

        <% if (jobs.length === 0) { %>
          <div class="empty-state">
            No tasks yet. Start a conversation and I'll create tasks for your goals.
          </div>
        <% } else { %>
          <% jobs.forEach(job => { %>
            <div class="job-card" data-job-id="<%= job.job_id %>">
              <div class="job-header">
                <strong><%= job.job_id %></strong>
              </div>
              <div class="task-list" id="tasks-<%= job.job_id %>">
                Loading tasks...
              </div>
              <div class="artifacts-section" id="artifacts-<%= job.job_id %>">
                <!-- Artifacts will be populated via JavaScript -->
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    // Pass conversation ID to JavaScript
    window.CONVERSATION_ID = <%= conversation.id %>;
    window.JOBS = <%- JSON.stringify(jobs) %>;

    // Handle model selection change
    <% if (overridesAllowed && userConfig) { %>
    const modelSelect = document.getElementById('modelSelect');
    if (modelSelect) {
      modelSelect.addEventListener('change', async () => {
        const modelRef = modelSelect.value === 'user' ? 'user' : null;

        try {
          const response = await fetch(`/chat/${window.CONVERSATION_ID}/model`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ modelRef })
          });

          if (!response.ok) {
            alert('Failed to update model preference');
            return;
          }

          // Show brief success indication
          const originalBg = modelSelect.style.background;
          modelSelect.style.background = '#d4edda';
          setTimeout(() => {
            modelSelect.style.background = originalBg;
          }, 500);
        } catch (error) {
          console.error('Error updating model:', error);
          alert('Failed to update model preference');
        }
      });
    }
    <% } %>
  </script>
  <script src="/js/chat-client.js"></script>
</body>
</html>
