<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Desk Platform</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <header>
        <nav>
            <div class="nav-brand">
                <a href="/">Desk Platform</a>
            </div>
            <% if (user) { %>
            <div class="nav-menu">
                <span class="nav-user"><%= user.username %> (<%= user.role %>)</span>
                <form action="/logout" method="POST" style="display: inline;">
                    <button type="submit" class="btn-secondary">Logout</button>
                </form>
            </div>
            <% } %>
        </nav>
    </header>

    <main>
        <%- body %>
    </main>

    <footer>
        <p>Desk Platform MVP - Server-Rendered Web UI</p>
    </footer>
</body>
</html>
